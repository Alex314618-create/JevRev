          "sha256": "b08bd0d8080f4ee6038b97140d08f3ee1047a8b30546d903341e58251a9f06f7",
          "size_bytes": 401,
          "content_excerpt": "export function countDelimiters(input) {\r\n  let quoted = false;\r\n  let count = 0;\r\n  for (let index = 0; index < input.length; index += 1) {\r\n    const code = input.charCodeAt(index);\r\n    if (code === 34) {\r\n      if (quoted && input.charCodeAt(index + 1) === 34) index += 1;\r\n      else quoted = !quoted;\r\n    } else if (code === 44 && !quoted) {\r\n      count += 1;\r\n    }\r\n  }\r\n  return count;\r\n}\r\n"
        }
      ],
