{
  "name": "jevrev",
  "version": "0.2.0",
  "description": "A decision layer beside your LLM for exploring approaches, testing evidence, and continuing the work worth doing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "jevrev": "dist/cli.js",
    "specjev": "dist/cli.js",
    "jevrev-skill-install": "scripts/install-skill.mjs",
    "jevrev-evidence-template": "scripts/create-evidence-template.mjs"
  },
  "files": [
    "dist",
    "docs/ACCEPTANCE.md",
    "docs/CASE_STUDY.md",
    "docs/DESIGN.md",
    "docs/LOCAL_BASELINE.md",
    "docs/LOCAL_MODEL.md",
    "docs/PROTOCOL.md",
    "docs/SEMIF_LOCAL.md",
    "docs/TEST_PLAN.md",
    "docs/WORKFLOW.md",
    "docs/EXTREME_TESTS.md",
    "docs/ACTIVATION.md",
    "docs/JEVLOOP_DESIGN.md",
    "docs/JEVLONG_DESIGN.md",
    "docs/AUTHORITY.md",
    "examples",
    "benchmarks/one-shot-showcase",
    "benchmarks/engineering-showcase",
    "benchmarks/workflow-fixture",
    "benchmarks/real-jsonl-ingestion",
    "scripts",
    "skills/jevrev",
    "runtime",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "RELEASE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node dist/cli.js run --input examples/parser-speedup.json --replay examples/parser-jev-response.json --format human",
    "demo:all": "node scripts/run-demos.mjs",
    "demo:workflow": "node scripts/run-workflow-demo.mjs",
    "demo:loop": "node scripts/run-loop-demo.mjs",
    "demo:engineering": "node scripts/run-engineering-showcase.mjs",
    "demo:oneshot": "node scripts/validate-one-shot-showcase.mjs",
    "showcase:serve": "node scripts/serve-one-shot-showcase.mjs",
    "showcase:engineering": "node scripts/serve-engineering-showcase.mjs",
    "eval:cases": "node scripts/eval-cases.mjs",
    "benchmark:demos": "node scripts/benchmark-demos.mjs",
    "install-skill": "node scripts/install-skill.mjs",
    "evidence-template": "node scripts/create-evidence-template.mjs",
    "prepare": "npm run build",
    "prepack": "npm run check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex314618-create/JevRev.git"
  },
  "homepage": "https://github.com/Alex314618-create/JevRev#readme",
  "bugs": {
    "url": "https://github.com/Alex314618-create/JevRev/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "llm",
    "ai",
    "agents",
    "coding",
    "workflow",
    "evaluation",
    "cli"
  ],
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "commander": "^14.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
